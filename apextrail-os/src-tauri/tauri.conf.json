{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApexTrail OS",
  "version": "1.0.0",
  "identifier": "com.apextrail.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ApexTrail OS",
        "width": 1280,
        "height": 840,
        "minWidth": 390,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
